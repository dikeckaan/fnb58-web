{
  // Cloudflare Workers, static assets only. Deploy with: npm run deploy:cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fnb58-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
